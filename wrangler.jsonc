{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "om-food-exact",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "OM_RUNTIME": "cloudflare"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
